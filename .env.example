# ── LLM Backend ──────────────────────────────────────────────────────
# Options: openrouter | anthropic | openai | template
LLM_BACKEND=openrouter

# OpenRouter (recommended — free models available)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Anthropic (Claude) — optional alternative
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — optional alternative
OPENAI_API_KEY=sk-...

# Model (default: arcee-ai/trinity-large-preview:free)
LLM_MODEL=arcee-ai/trinity-large-preview:free
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# ── Whisper ───────────────────────────────────────────────────────────
WHISPER_MODEL=base
WHISPER_LANGUAGE=en

# ── Diarization ───────────────────────────────────────────────────────
ENABLE_DIARIZATION=false
HUGGINGFACE_TOKEN=hf_...

# ── Embeddings ────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Chunking ──────────────────────────────────────────────────────────
CHUNK_MAX_WORDS=120
CHUNK_OVERLAP_SEGMENTS=1

# ── RAG ───────────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3

# ── API Server ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=info
